{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "InfinityCoder",
  "version": "3.0.0",
  "identifier": "com.miron.infinitycoder",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "InfinityCoder",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "languages": ["Russian", "English"],
        "installMode": "currentUser"
      }
    },
    "resources": ["bin/*"],
    "externalBin": ["bin/llama-server-vulkan"]
  }
}
